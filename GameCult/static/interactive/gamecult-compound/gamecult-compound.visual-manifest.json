{
  "asset_base": "/static/interactive/cotsc-praxis/",
  "default_caption": "GameCult Compound",
  "global_style_cue": "Stripped-down website visual novel stage using clean card chrome, high-contrast public-document panels, restrained studio lighting, visible project-room affordances, and no full background image. The scene is represented through stage cards, route plaques, document surfaces, and speaker portraits so it blends into the Quartz page instead of covering it.",
  "metadata_contract": "Sai renders scene labels, backgrounds, actor avatars, named sprites, dom_cards, and space metadata. The spaces map is the canonical website-compound contract: each space is a project, topic, repo, setting, tool, docs shelf, blog lane, or receipt surface with a host and canonical URL.",
  "scene_set": {
    "id": "gamecult_compound_card_stage",
    "purpose": "A reusable card-chrome compound layout for homepage replay. The stage is not a generated background; it is a durable arrangement of document-backed route cards, speaker panels, and room-specific props that can preserve hub geography and visited-state markers.",
    "layout": "Wide compound hub with route plaques arranged around the dialogue frame. Each project room swaps in two or three DOM-backed cards plus a small prop metaphor: forge workbench, ledger counter, archive terminal, library shelves, gate console, or proof wall. Return visits mark completed rooms with checked plaque state.",
    "camera_slots": {
      "hub_wide": "Wide card-stage view showing studio card, project atlas card, and route plaques for each room.",
      "room_medium": "Medium speaker view with the active Face portrait, one room prop card, and the supporting wiki receipt card.",
      "receipt_close": "Close document-card view for proof, docs, and source links."
    }
  },
  "scenes": {
    "compound": {
      "label": "Front Gate",
      "camera": "hub_wide",
      "visible_actors": [
        "Void"
      ],
      "visual_anchor": "A public studio compound rendered as clean website cards rather than a painted background: central GameCult welcome card, project-atlas card, docs card, and route plaques for forge, ledger, archive, library, gate, proof wall, and direct wiki exit.",
      "dom_card_roles": {
        "studio": "central welcome placard",
        "projects": "project atlas signboard",
        "docs": "plain wiki exit"
      },
      "background": "backgrounds/compound.png"
    },
    "forge": {
      "label": "Epiphany Forge",
      "camera": "room_medium",
      "visible_actors": [
        "Epiphany"
      ],
      "visual_anchor": "Agent-state forge represented by a workbench card, pinned machine map, evidence ledger sheet, verification checklist, and Epiphany portrait beside the project receipt card.",
      "dom_card_roles": {
        "epiphany": "project receipt card",
        "proof": "evidence sheet on the workbench"
      },
      "background": "backgrounds/forge.png"
    },
    "ledger": {
      "label": "Bifrost Ledger Hall",
      "camera": "room_medium",
      "visible_actors": [
        "Void"
      ],
      "visual_anchor": "Public labor ledger counter with work item slips, claim stamps, review marks, credit trail, and payout-risk warning card; Bifrost documentation appears as the inspectable receipt behind the scene.",
      "dom_card_roles": {
        "bifrost": "ledger desk card",
        "proof": "receipt example panel"
      },
      "background": "backgrounds/ledger.png"
    },
    "archive": {
      "label": "VoidBot Archive Room",
      "camera": "room_medium",
      "visible_actors": [
        "Void"
      ],
      "visual_anchor": "Archive terminal and shelf-card scene with Discord history, repo search, lore lookup, and Codex handoff routes shown as labeled drawers rather than abstract database language.",
      "dom_card_roles": {
        "voidbot": "archive terminal card",
        "projects": "repo atlas drawer"
      },
      "background": "backgrounds/archive.png"
    },
    "library": {
      "label": "CultLib Library",
      "camera": "room_medium",
      "visible_actors": [
        "Libby"
      ],
      "visual_anchor": "Typed-record library with labeled shelves for stored documents, messages, and distributed state; Libby stands near a stamp pad marked with schema, provenance, and public inspection.",
      "dom_card_roles": {
        "cultlib": "library shelf card",
        "docs": "public docs shelf"
      },
      "background": "backgrounds/library.png"
    },
    "gate": {
      "label": "Heimdall Gatehouse",
      "camera": "room_medium",
      "visible_actors": [
        "Heimdall"
      ],
      "visual_anchor": "Identity and consent gate rendered as a credential console with grant, session, revocation, and signed-claim panels; the gate visibly has both entry and refusal paths.",
      "dom_card_roles": {
        "heimdall": "gate console card",
        "bifrost": "authority trail card"
      },
      "background": "backgrounds/gate.png"
    },
    "receipts": {
      "label": "Proof Walk",
      "camera": "receipt_close",
      "visible_actors": [
        "Void"
      ],
      "visual_anchor": "Proof wall made of public document cards: current site graph, damage report, repo links, future Bifrost receipt checklist, known-risk note, and roadmap panel.",
      "dom_card_roles": {
        "proof": "current receipt checklist",
        "roadmap": "future ledger path"
      },
      "background": "backgrounds/receipts.png"
    }
  },
